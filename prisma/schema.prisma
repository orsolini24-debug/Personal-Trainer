  MACHINE
  BODYWEIGHT
  KETTLEBELL
  RESISTANCE_BAND
  SMITH_MACHINE
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum PlanSource {
  MANUAL
  AI_GENERATED
  IMPORTED
}

enum PlannedStatus {
  PENDING
  COMPLETED
  SKIPPED
}

enum MealType {
  BREAKFAST
  LUNCH
  PRE_WORKOUT
  POST_WORKOUT
