generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── AUTH ───────────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String
  name          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  onboardingCompleted Boolean @default(false)

  profile          UserProfile?
  mesocycles       Mesocycle[]
  workoutSessions  WorkoutSession[]
  nutritionDays    NutritionDay[]
  biometricLogs    BiometricLog[]
  recoveryLogs     RecoveryLog[]
  devices          UserDevice[]
  injuries         Injury[]
  aiReports        AIReport[]
  workoutPlans     WorkoutPlan[]
  plannedSessions  PlannedSession[]
  activeSession    ActiveSession?
  goals            AthleteGoal[]
  mealTemplates    MealTemplate[]
  manualActivities ManualActivity[]
  dailyAnalyses    DailyAnalysis[]
}

model UserProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Step 1 – Bio & Body Comp
  biologicalSex    String?  // "MALE", "FEMALE"
  birthDate        DateTime?
  ageYears         Int?
  weightKg         Float?
  heightCm         Int?
  bodyFatPct       Float?   // Massa grassa %
  leanMassKg       Float?   // Massa magra kg
  bodyMeasurements Json?    // { waist, hips, chest, arm, thigh }
  hasProfessionalData Boolean @default(false) // Se i dati vengono da BIA/Nutrizionista

  // Step 2 – Sport DNA (Universal)
  primarySport     SportType @default(PALESTRA)
  mainSports       SportType[]
  sportLevels      Json?    // { SOCCER: "AMATEUR", RUNNING: "COMPETITIVE" }
  
  // Sport Specific Metrics
  runningData      Json?    // { avgPace, maxDistance, pb5k, pb10k, pbHalf }
  cyclingData      Json?    // { avgPower, ftp, maxDistance }
  combatData       Json?    // { yearsExperience, style, weightClass }
  technicalSportData Json?  // { level, frequency, specificGoals }

  experienceLevel  String?  // "BEGINNER", "INTERMEDIATE", "ADVANCED"
  trainingYears    Int?
  strengthRefs     Json?    // { squat1RM, bench1RM, deadlift1RM, ohp1RM }

  // Step 3 – Goals & Current Status
  primaryGoal      String?  
  isFollowingPlan  Boolean  @default(false)
  currentPlanFile  String?  // URL a file caricato (PDF/XLS)
  currentPlanText  String?  @db.Text
  targetEvent      String?  

  // Step 4 – Nutrition & Habits
  dietaryType      String?  // "OMNIVORE", "VEGETARIAN", "VEGAN", "KETO", etc.
  eatingRoutine    Json?    // { mealsPerDay: 4, snacks: true, intermittentFasting: false }
  favoriteFoods    String[]
  dislikedFoods    String[]
  allergies        String[]
  dailyRoutine     String?  @db.Text // Descrizione della giornata tipo (lavoro sedentario, etc.)

  // Step 5 – Logistics
  availableDays    Int?     
  sessionDuration  Int?     
  equipmentLevel   String?  
  preferredSplit   String?  

  injuriesList         String[]
  updatedAt            DateTime @updatedAt
}

model AthleteGoal {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         GoalType
  sport        SportType?
  description  String    @db.Text
  targetValue  Float?
  currentValue Float?
  targetDate   DateTime?
  unit         String?   // "kg", "min/km", "%", "kg/bw", etc.
  priority     Int       @default(1)
  isActive     Boolean   @default(true)
  notes        String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ─── TRAINING ────────────────────────────────────────────────────────────────

model Mesocycle {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  startDate   DateTime
  endDate     DateTime?
  objectives  String?
  kpi         Json?
  status      MesoStatus @default(ACTIVE)
  aiProposals  Json?      // Memorizza le 3 opzioni generate dall'AI
  chosenOption Int?       // Quale delle 3 è stata scelta
  generatedFor Json?      // Goals snapshot used to generate this meso
  planType     String?    @default("FULL") // "FULL", "TRAINING_ONLY", "NUTRITION_ONLY"
  createdAt   DateTime @default(now())

  sessions     WorkoutSession[]
  workoutPlans WorkoutPlan[]
}

model WorkoutSession {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  mesocycleId   String?
  mesocycle     Mesocycle?      @relation(fields: [mesocycleId], references: [id])
  date          DateTime
  type          SessionType
  sportType     SportType?      // Se è un'attività sportiva specifica
  sportData     Json?           // Dati tecnici specifici (gol, set, passi, bpm)
  durationMin   Int?
  trainingLoad  Float?
  rpe           Int?
  notes         String?
  voiceNoteUrl  String?
  suuntoId      String?
  createdAt     DateTime        @default(now())

  exercises       Exercise[]
  districtStress  DistrictStress[]
  plannedSession  PlannedSession?
  activeSession   ActiveSession?
}

model Exercise {
  id             String         @id @default(cuid())
  sessionId      String
  session        WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name           String
  orderIndex     Int            @default(0)
  sets           Int?
  reps           String?
  loadKg         Float?
  rir            Int?
  
  // Expanded metadata fields
  restSec        Int?
  repsMin        Int?
  repsMax        Int?
  planNotes      String?
  
  technicalNotes String?
  createdAt      DateTime       @default(now())

  setLogs        SetLog[]
}

model DistrictStress {
  id         String         @id @default(cuid())
  sessionId  String
  session    WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  district   District
  intensity  Int
}

model SessionStressDefinition {
  id          String      @id @default(cuid())
  sessionType SessionType
  district    District
  intensity   Int
  @@unique([sessionType, district])
}

// ─── WORKOUT PLANS (SCHEDE) ──────────────────────────────────────────────────

model WorkoutPlan {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  mesocycleId   String?
  mesocycle     Mesocycle?   @relation(fields: [mesocycleId], references: [id])
  name          String
  description   String?      @db.Text
  goal          String?
  weeksTotal    Int          @default(4)
  daysPerWeek   Int          @default(3)
  trainingDays  Int[]        // [1,3,5] = Mon/Wed/Fri (0=Dom, 1=Lun, ...)
  isActive      Boolean      @default(true)
  source        PlanSource   @default(MANUAL)
  createdAt     DateTime     @default(now())

  planDays        PlanDay[]
  plannedSessions PlannedSession[]
}

model PlanDay {
  id          String      @id @default(cuid())
  planId      String
  plan        WorkoutPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  dayLabel    SessionType
  focus       String?     // "Upper - Petto/Spalle/Tricipiti"
  orderIndex  Int         @default(0)
  notes       String?

  planExercises   PlanExercise[]
  plannedSessions PlannedSession[]
}

model PlanExercise {
  id             String              @id @default(cuid())
  planDayId      String
  planDay        PlanDay             @relation(fields: [planDayId], references: [id], onDelete: Cascade)
  exerciseDefId  String?
  exerciseDef    ExerciseDefinition? @relation(fields: [exerciseDefId], references: [id])
  name           String
  orderIndex     Int                 @default(0)
  sets           Int                 @default(3)
  repsMin        Int                 @default(8)
  repsMax        Int                 @default(12)
  targetRir      Int                 @default(2)
  restSec        Int                 @default(120)
  notes          String?
}

// ─── PLANNED SESSIONS (CALENDARIO) ───────────────────────────────────────────

model PlannedSession {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId           String
  plan             WorkoutPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  planDayId        String
  planDay          PlanDay       @relation(fields: [planDayId], references: [id])
  scheduledDate    DateTime      @db.Date
  status           PlannedStatus @default(PENDING)
  workoutSessionId       String?       @unique
  workoutSession         WorkoutSession? @relation(fields: [workoutSessionId], references: [id])
  skipReason             String?
  substituteForPlanDayId String?

  // One session per plan per day per user — allows scheduling multiple plans on same day
  @@unique([userId, planId, scheduledDate])
}

// ─── ACTIVE SESSION (real-time tracker state) ─────────────────────────────────

model ActiveSession {
  id                 String         @id @default(cuid())
  userId             String         @unique
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutSessionId   String         @unique
  workoutSession     WorkoutSession @relation(fields: [workoutSessionId], references: [id])
  currentExerciseIdx Int            @default(0)
  currentSetIdx      Int            @default(0)
  startedAt          DateTime       @default(now())
  lastActivityAt     DateTime       @updatedAt

  setLogs            SetLog[]
}

model SetLog {
  id              String        @id @default(cuid())
  activeSessionId String
  activeSession   ActiveSession @relation(fields: [activeSessionId], references: [id], onDelete: Cascade)
  exerciseId      String
  exercise        Exercise      @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  setNumber       Int
  weightKg        Float?
  repsActual      Int?
  rirActual       Int?
  isWarmup        Boolean       @default(false)
  feelingScore    Int?          // 1=poor, 2=hard, 3=ok, 4=good, 5=great
  perceivedLoad   Float?        // RPE this set
  completedAt     DateTime      @default(now())

  @@unique([activeSessionId, exerciseId, setNumber])
}

// ─── EXERCISE LIBRARY ─────────────────────────────────────────────────────────

model ExerciseDefinition {
  id               String      @id @default(cuid())
  name             String      @unique
  nameIt           String?     // Nome tradotto in italiano
  nameAlt          String?
  primaryMuscles   District[]
  secondaryMuscles District[]
  equipment        Equipment
  difficulty       Difficulty  @default(INTERMEDIATE)
  isCompound       Boolean     @default(true)
  movementType     MovementType @default(OTHER)
  description      String?     @db.Text
  descriptionIt    String?     @db.Text // Spiegazione dettagliata in italiano
  tips             String?     @db.Text
  tipsIt           String?     @db.Text
  mediaUrl         String?     // Link a immagine o animazione principale
  mediaUrls        String[]    // Lista di tutti i link media (es. start/end position)
  createdAt        DateTime    @default(now())

  planExercises    PlanExercise[]
}

// ─── NUTRITION ───────────────────────────────────────────────────────────────
model NutritionDay {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime @db.Date
  kcalTarget   Int?
  kcalActual   Int?
  proteinG     Float?
  carbsG       Float?
  fatG         Float?
  waterL       Float    @default(0) // Acqua in litri
  isTrainingDay Boolean @default(false)
  createdAt    DateTime @default(now())

  meals  Meal[]

  @@unique([userId, date])
}

model Meal {
  id              String       @id @default(cuid())
  nutritionDayId  String
  nutritionDay    NutritionDay @relation(fields: [nutritionDayId], references: [id], onDelete: Cascade)
  type            MealType
  suggestedFoods  String[]     // Alimenti suggeriti dal piano (solo visualizzazione)
  createdAt       DateTime     @default(now())

  foodItems FoodItem[]
}

model FoodItem {
  id         String     @id @default(cuid())
  mealId     String
  meal       Meal       @relation(fields: [mealId], references: [id], onDelete: Cascade)
  name       String
  quantityG  Float?
  kcal       Float?
  proteinG   Float?
  carbsG     Float?
  fatG       Float?
  source     FoodSource @default(MANUAL)
}

model MealTemplate {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  mealType     MealType
  items        Json     // Array di { name, quantityG, kcal, proteinG, carbsG, fatG }
  totalKcal    Int
  totalProtein Float
  createdAt    DateTime @default(now())
}

// ─── BIOMETRIA ───────────────────────────────────────────────────────────────

model BiometricLog {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime      @db.Date
  weightKg     Float?
  fatPct       Float?
  muscleMassKg Float?
  waterPct     Float?
  waistCm      Float?
  hipsCm       Float?
  chestCm      Float?
  armCm        Float?
  thighCm      Float?
  photoUrl     String?
  source       MetricSource  @default(MANUAL)
  createdAt    DateTime      @default(now())

  @@unique([userId, date])
}

model UserDevice {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  ecosystem     Ecosystem
  deviceModel   String?
  appName       String?
  isPrimary     Boolean     @default(false)
  notes         String?
  createdAt     DateTime    @default(now())
}

model RecoveryLog {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          DateTime    @db.Date
  enteredAt     DateTime    @default(now())
  source        DataSource  @default(MANUAL)
  screenshotUrl String?
  ctl           Float?
  atl           Float?
  tsb           Float?
  acwr          Float?
  hrv           Float?
  rhr           Int?
  sleepMin      Int?
  sleepScore    Int?
  recoveryScore Int?

  @@unique([userId, date])
}

model Injury {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  district    District
  description String
  startDate   DateTime
  endDate     DateTime?
  status      InjuryStatus  @default(ACTIVE)
  notes       String?
  createdAt   DateTime      @default(now())
}

model AIReport {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         ReportType
  date         DateTime
  content      String     @db.Text
  dataInputJson Json?
  createdAt    DateTime   @default(now())
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

